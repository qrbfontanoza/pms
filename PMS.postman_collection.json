{
  "info": {
    "name": "PMS Car Rental API",
    "description": "JSON API surface used by both the web front end and (eventually) the mobile app. Run against the local XAMPP server first, then swap {{base_url}} for the hosted URL once deployed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost/pms" },
    { "key": "vehicle_id", "value": "19" },
    { "key": "voucher_code", "value": "SAVE300" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/register.php"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/login.php"
          }
        },
        {
          "name": "Me (session check)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/me.php"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/logout.php"
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "List vehicles",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api_vehicles.php"
          }
        },
        {
          "name": "List vehicles by category",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api_vehicles.php?category=Sedan"
          }
        },
        {
          "name": "Vehicle detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api_vehicles.php?id={{vehicle_id}}"
          }
        }
      ]
    },
    {
      "name": "Vouchers",
      "item": [
        {
          "name": "List available vouchers",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/get_vouchers.php"
          }
        },
        {
          "name": "Apply voucher (preview)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"voucher_code\": \"{{voucher_code}}\",\n  \"total_amount\": 5500\n}"
            },
            "url": "{{base_url}}/apply_voucher.php"
          }
        }
      ]
    },
    {
      "name": "Booking",
      "item": [
        {
          "name": "Reserve preview",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": {{vehicle_id}},\n  \"rental_date\": \"2026-08-10\",\n  \"return_date\": \"2026-08-12\",\n  \"pickup_time\": \"09:00\",\n  \"dropoff_time\": \"09:00\",\n  \"contact_number\": \"09171234567\",\n  \"age\": 25,\n  \"is_preview\": true\n}"
            },
            "url": "{{base_url}}/reserve_preview.php"
          }
        },
        {
          "name": "Create booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": {{vehicle_id}},\n  \"rental_date\": \"2026-08-10\",\n  \"return_date\": \"2026-08-12\",\n  \"pickup_time\": \"09:00\",\n  \"dropoff_time\": \"09:00\",\n  \"contact_number\": \"09171234567\",\n  \"age\": 25,\n  \"amount_paid\": 5500\n}"
            },
            "url": "{{base_url}}/reserve.php"
          }
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": 1\n}"
            },
            "url": "{{base_url}}/cancel_booking.php"
          }
        },
        {
          "name": "Return early",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": 1\n}"
            },
            "url": "{{base_url}}/return_early.php"
          }
        }
      ]
    }
  ]
}
